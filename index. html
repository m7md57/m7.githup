["عبدالله أبشر","المقصف","أول ثانوي","رابع ابتدائي ب","الملعب","المقصف"],
["سيف حسن","الملعب","الملعب","الملعب","الملعب","الملعب"],
["خالد أحمد","الممر","المقصف","رابع ابتدائي أ","أول ثانوي","المقصف"],
["خالد محمد موسى","رابع ابتدائي أ","المقصف","الممر","أول متوسط","رابع ابتدائي ب"],
